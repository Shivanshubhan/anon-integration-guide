import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { getServerSession } from "next-auth";
import { authOptions } from "@/app/api/auth/[...nextauth]/route";
import { OpenAI } from "openai";
import { sendRejectionEmail } from "@/lib/email";

const openai = new OpenAI(process.env.OPENAI_API_KEY!);

export async function POST(
  request: Request,
  { params }: { params: { id: string } }
) {
  const session = await getServerSession(authOptions);
  
  if (!session || session.user.role !== "RECRUITER") {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  }

  const { reasons, details, isAnonymous } = await request.json();

  // Validate feedback
  if (!reasons?.length || !details || details.length < 200) {
    return NextResponse.json(
      { error: "Detailed feedback (min 200 chars) and at least one reason required" },
      { status: 400 }
    );
  }

  try {
    // Get application data
    const application = await prisma.application.update({
      where: { id: params.id },
      data: { status: "REJECTED" },
      include: {
        job: { include: { company: true } },
        candidate: true,
      },
    });

    // AI analysis
    const aiResponse = await openai.chat.completions.create({
      model: "gpt-4",
      messages: [{
        role: "user",
        content: `Analyze this job rejection feedback for quality:
        Reasons: ${reasons.join(", ")}
        Details: ${details}
        
        Return JSON with: qualityScore (1-10), isGeneric (boolean), improvementSuggestions (string)`
      }],
    });

    const aiAnalysis = JSON.parse(aiResponse.choices[0].message.content || "{}");

    // Create feedback
    await prisma.feedback.create({
      data: {
        applicationId: params.id,
        reasons,
        details,
        isAnonymous,
        aiAnalysis,
      },
    });

    // Send email notification
    await sendRejectionEmail(
      application.candidate.email,
      `Your application for ${application.job.title} at ${application.job.company.name} was not successful.`,
      details
    );

    // Update company compliance metrics
    await updateCompanyMetrics(application.job.companyId);

    return NextResponse.json({ success: true });
  } catch (error) {
    console.error(error);
    return NextResponse.json(
      { error: "Failed to reject application" },
      { status: 500 }
    );
  }
}

